# গিট (Git) সম্পর্কিত ফাইল
.git
.gitignore

# ভার্চুয়াল এনভায়রনমেন্ট
venv/
env/
.venv/

# পাইথনের ক্যাশ ও কম্পাইলড ফাইল
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# সিক্রেট ও কনফিগারেশন ফাইল (যাতে পাসওয়ার্ড বা API key লিক না হয়)
.env
.env.local

# লোকাল ডাটাবেস (যদি আপনি SQLite ব্যবহার করে থাকেন)
db.sqlite3

# ডকার সম্পর্কিত ফাইল (কন্টেইনারের ভেতর এগুলোর দরকার নেই)
Dockerfile
docker-compose.yml
.dockerignore

# IDE ও এডিটর সেটিংস
.vscode/
.idea/
*.swp
*.swo

# জ্যাঙ্গো স্ট্যাটিক ও মিডিয়া ফাইল (এগুলো সাধারণত প্রোডাকশনে ক্লাউড বা ভলিউমে থাকে)
# যদি কন্টেইনারের ভেতরেই এগুলো সার্ভ করতে চান, তবে এগুলো বাদ দিতে পারেন
static/
media/